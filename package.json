{
  "name": "rummy-multiplayer",
  "version": "1.0.0",
  "description": "Production-quality real-time multiplayer Indian Rummy with private cards and LiveKit video calling",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:server": "tsc -p server/tsconfig.json && node server/dist/index.js",
    "dev:client": "cd client && next dev -p 3000",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "tsc -p server/tsconfig.json",
    "build:client": "cd client && next build",
    "build": "npm run build:server && npm run build:client",
    "start:server": "node server/dist/index.js",
    "start:client": "cd client && next start -p 3000",
    "test": "npm run build:server && node --test server/tests/engine.test.cjs server/tests/rummy_rules_audit.test.cjs server/tests/sprint_7_fixes.test.cjs server/tests/privacy_multiplayer.test.cjs server/tests/phase1_security.test.cjs server/tests/dbErrors.test.cjs",
    "test:e2e": "npm run build:server && node server/tests/run_e2e.cjs",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@livekit/components-react": "^2.6.8",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "framer-motion": "^11.13.1",
    "jsonwebtoken": "^9.0.2",
    "livekit-client": "^2.7.4",
    "livekit-server-sdk": "^2.9.4",
    "lucide-react": "^0.468.0",
    "next": "^16.4.6",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.5.5",
    "uuid": "^11.0.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.5.33",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.16",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
