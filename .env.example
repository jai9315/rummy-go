# =============================================================================
# Rummy Go — Environment Configuration
# Copy this file to .env and fill in real values before starting the server.
# Never commit .env to version control. .env.example is safe to commit.
# =============================================================================

# Backend HTTP & Socket.IO listening port (default: 4000)
PORT=4000

# Runtime environment: development | production | test
NODE_ENV=development

# SQLite database file path read by server/src/db/prisma.ts (Node 22 node:sqlite).
# Parent directories and tables are created automatically on startup.
# Local default: file:./prisma/dev.db  |  Docker volume path: file:/app/data/rummy.db
DATABASE_URL=file:./prisma/dev.db

# Allowed frontend origin(s) for CORS and room invite links.
# Supports a comma-separated list for multiple origins; the first entry is used for invite URLs.
CLIENT_URL=http://localhost:3000

# Public backend URL baked into the Next.js client bundle at build time
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# JWT signing secret — REQUIRED (server fails fast if missing).
# Generate a strong random string, e.g.: openssl rand -base64 32
JWT_SECRET=change_me_to_a_strong_random_secret

# LiveKit credentials — REQUIRED for WebRTC audio/video token generation
# (server fails fast if missing). Use LiveKit Cloud or a self-hosted LiveKit server.
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-livekit-server.example.com
