# =============================================================================
# Rummy Go — Environment Configuration
# Copy this file to .env and fill in real values before running in production.
# Never commit .env to version control. .env.example is safe to commit.
# =============================================================================

# Server port
PORT=4000

# Node environment
NODE_ENV=development

# Database (SQLite)
DATABASE_URL=file:./prisma/dev.db

# JWT secret — REQUIRED. Generate a strong random string, e.g.:
#   openssl rand -base64 32
# Never use the default/fallback value in production.
JWT_SECRET=your_jwt_secret_here_change_me

# Client URL (for invite links, CORS, etc.)
CLIENT_URL=http://localhost:3000

# Next.js public server URL
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# LiveKit — REQUIRED for video/audio calling.
# Obtain these from your LiveKit Cloud dashboard or self-hosted LiveKit.
# Do NOT use demo credentials in production.
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-livekit-server.com